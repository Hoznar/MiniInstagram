@model net08.Models.ViewModels.PasswordViewModel
@{
ViewData["Title"] = "Post";
}

<div class="row align-items-center mt-4">
    <div class="d-flex justify-content-center mb-3">
        <a class="btn btn-outline-light me-3" asp-controller="Profile" asp-action="Edit">Osobní údaje</a>
        <a class="btn btn-outline-light me-3" asp-controller="Account" asp-action="Password">Změna hesla</a>
        <a class="btn btn-outline-danger" asp-controller="Account" asp-action="Delete">Odstranit účet</a>
    </div>

    <div class="d-flex justify-content-center mb-3">
        <form asp-action="Password" asp-controller="Account" method="post" class="w-75">
            <h4 class="text-white mb-4 fw-bolder">Změnit heslo:</h4>
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3 form-group">
                <input asp-for="OldPassword" class="form-control bg-black border-secondary text-white" placeholder="Staré heslo"/>
                <span asp-validation-for="OldPassword" class="text-danger"></span>
            </div>
            <div class="mb-3 form-group">
                <input asp-for="NewPassword" class="form-control bg-black border-secondary text-white" placeholder="Nové heslo"/>
                <span asp-validation-for="NewPassword" class="text-danger"></span>
            </div>
            <div class="mb-3 form-group">
                <input asp-for="ConfirmPassword" class="form-control bg-black border-secondary text-white" placeholder="Podtrvrdit nové heslo"/>
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>
            @if (TempData["Success"] != null) {
                <p class="text-white">@TempData["Success"]</p>
            }
            <div class="mb-3 form-group d-flex justify-content-center">
                <button type="submit" class="btn btn-primary w-50 me-5">Změnit</button>
            </div>
        </form>
    </div>
</div>