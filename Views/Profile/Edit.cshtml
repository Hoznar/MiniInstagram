@model net08.Models.ViewModels.ProfileEditViewModel
@{
ViewData["Title"] = "Post";
}

<div class="row align-items-center mt-4">
    <div class="d-flex justify-content-center mb-3">
        <a class="btn btn-outline-light me-3" asp-controller="Profile" asp-action="Edit">Osobní údaje</a>
        <a class="btn btn-outline-light me-3" asp-controller="Account" asp-action="Password">Změna hesla</a>
        <a class="btn btn-outline-danger" asp-controller="Account" asp-action="Delete">Odstranit účet</a>
    </div>
    <div class="d-flex justify-content-center mb-3">
        <form asp-action="Edit" asp-controller="Profile" method="post" class="w-75" enctype="multipart/form-data">
            <h4 class="text-white mb-4 fw-bolder">Změnit osobní údaje:</h4>
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3 form-group">
                <p for="Avatar" class="form-label fw-bold text-white">Profilový obrázek</p>
                <input asp-for="Avatar" class="form-control bg-black border-secondary text-secondary" type="file"/>
                <span asp-validation-for="Avatar" class="text-danger"></span>
            </div>
            <div class="mb-3 form-group">
                <p for="FirstName" class="form-label fw-bold text-white">Osobní údaje</p>
                <input asp-for="FirstName" class="form-control bg-black border-secondary text-white" id="FirstName" value="@Model.FirstName"/>
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>
            <div class="mb-3 form-group">
                <input asp-for="LastName" class="form-control bg-black border-secondary text-white" value="@Model.LastName"/>
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>
            <div class="mb-3 form-group">
                <input asp-for="Age" class="form-control bg-black border-secondary text-white" value="@Model.Age"/>
                <span asp-validation-for="Age" class="text-danger"></span>
            </div>
            <div class="mb-3 form-group">
                <label for="Username" class="form-label fw-bold text-white">Přezdívka</label>
                <input asp-for="Username" class="form-control bg-black border-secondary text-white" id="Username" value="@Model.Username"/>
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>
            <div class="mb-3 form-group d-flex justify-content-center">
                <button type="submit" class="btn btn-primary w-50 me-5">Změnit</button>
            </div>
        </form>
    </div>
</div>