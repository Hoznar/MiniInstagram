@using System.Security.Claims
@using Microsoft.AspNetCore.Mvc.TagHelpers
@model IEnumerable<net08.Models.ViewModels.PostViewModel>
@{
    ViewData["Title"] = "Home Page";
    var loggedId = int.Parse(User.FindFirstValue(ClaimTypes.NameIdentifier));
}

<div class="container-md container-feed">
    
    <!-- Hlavička stránky, zobrazí výběr pro vypsání všech příspěvků, nebo jen těch od sledovaných -->
    <div class="row align-items-center border-bottom mt-4">
        <div class="d-flex justify-content-center gap-3 mb-3">
            <a class="btn btn-outline-light" asp-controller="Home" asp-action="Feed">Vše</a>
            <a class="btn btn-outline-light" asp-controller="Home" asp-action="Feed" asp-route-type="follow">Sledováno</a>
        </div>
    </div>

    <!-- Samotné vypisování příspěvků -->
    <div class="row justify-content-center mt-4">
        <div class="col-lg-6">
            @foreach (var viewModel in Model) {
                <div class="d-flex align-items-center mb-2">

                    <!-- Vykreslíme uživatelovu profilovku a informace -->
                    <img src="data:image/jpg;base64,@Convert.ToBase64String(@viewModel.User.Avatar)" alt="Profile picture" width="35px" height="35px" class="rounded-circle me-3">
                    <a asp-controller="Profile" asp-action="Show" asp-route-id="@viewModel.User.Id" class="text-decoration-none">
                        <p class="mb-0 text-white me-2 fw-bold">@viewModel.User.UserName</p>
                    </a>
                    <p class="mb-0 text-muted fw-light">@viewModel.Post.ReleaseDate.ToString("dd/MM/yyyy HH:mm")</p>
                </div>

                <!-- Text příspěvku včetně tagů -->
                <p class="text-white">@viewModel.Post.Text</p>
                <div class="mb-3">
                    @foreach (var tag in viewModel.Post.Tags) {
                        <span class="me-2" style="color: #0c63e4">@tag</span>
                    }
                </div>

                <!-- Pokud klikneme na obrázek nebo komentáře, zobrazí se detajlnější zobrazení příspěvku -->
                <div class="image-box" style="width: 400px; height: 400px">
                    <a asp-controller="Post" asp-action="Show" asp-route-id="@viewModel.Post.Id">
                        <img src="data:image/jpg;base64,@Convert.ToBase64String(@viewModel.Post.Image)" alt="Post image" class="img-fluid">
                    </a>
                </div>

                <!-- U lajkování z feedu by bylo nejlepší využít AJAX abych nemusel refreshovat stránku
                nebo zobrazovat Post View, ale nemám s tím zkušenosti, takže je to prozatím takhle -->
                <div class="d-flex align-items-center mb-5 mt-2">
                    <form asp-controller="Post" asp-action="Like" asp-route-id="@viewModel.Post.Id" method="post">
                        <button type="submit" class="btn p-0">
                            @if (viewModel.Post.LikedBy.Any(pl => pl.UserId == loggedId)) {
                                <img src="~/pictures/post-like-full.png" width="24px" height="24px" alt="Like Icon" class="me-2 icon">
                            }
                            else {
                                <img src="~/pictures/post-like.png" width="24px" height="24px" alt="Like Icon" class="me-2 icon">
                            }
                        </button>
                    </form>
                    <span class="text-white me-3">@viewModel.Post.LikedBy.Count</span>
                    <a asp-controller="Post" asp-action="Show" asp-route-id="@viewModel.Post.Id">
                        <img src="~/pictures/post-comment.png" width="24px" height="24px" alt="Comment Icon" class="me-2 icon">
                    </a>
                    <span class="text-white">@viewModel.Comments.Count()</span>
                </div>
            }
        </div>
    </div>
</div>